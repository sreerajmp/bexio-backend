# IMPORTANT: Write Environment variables in here

LOG_LEVEL=INFO

# ── Prisma Connection Pool ───────────────────────────────────────────────────
# Max DB connections per Prisma client (4 clients total).
# Total max connections = PRISMA_CONN_LIMIT × 4
# Keep (PRISMA_CONN_LIMIT × 4 × num_pods) < PostgreSQL max_connections (default 100)
# Example: 5 × 4 × 3 pods = 60 connections — safe for max_connections=100
PRISMA_CONN_LIMIT=5

# Seconds a query waits for a free connection before throwing an error.
# Prevents requests from hanging forever when pool is full.
PRISMA_POOL_TIMEOUT=10